# trial/server.env.example
# Copy the values into your host's environment (Render: Settings -> Environment).
# The public trial server holds NO private keys - only these settings.
#
#   PORT                 HTTP port (Render sets this for you)
#   TRIAL_DAYS           14
#   DOWNLOAD_URL         https://github.com/<you>/mizan-suite/releases/download/v1.0.0/Mizan%20Suite%20Setup%201.0.0.exe
#   MIZAN_SIGNER_TOKEN   same value as on your PC's signer
#   MIZAN_QUEUE_PATH     /data/queue.json   (persistent disk on your host)

PORT=3000
TRIAL_DAYS=14
DOWNLOAD_URL=
MIZAN_SIGNER_TOKEN=
MIZAN_QUEUE_PATH=./queue.json
